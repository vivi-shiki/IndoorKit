{
  "name": "indoorkit",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "verify": "pnpm lint && pnpm typecheck && pnpm test",
    "build:lib": "pnpm --filter \"./packages/*\" run build",
    "build": "pnpm build:lib"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.19.0",
    "@types/three": "^0.186.0",
    "happy-dom": "^21.0.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
